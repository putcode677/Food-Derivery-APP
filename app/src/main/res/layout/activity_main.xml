<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neo_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/spacing_large">

        <!-- Food Icon -->
        <TextView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:gravity="center"
            android:text="🍔"
            android:textSize="48sp"
            android:background="@drawable/neo_icon"
            android:elevation="@dimen/neo_elevation" />

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="FOOD DELIVERY"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_large"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="Delicious food, delivered to you"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_normal" />

        <!-- Login Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large"
            android:background="@drawable/neo_card"
            android:elevation="@dimen/neo_elevation">

            <!-- Email / Phone -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:hint="Email or phone number"
                android:inputType="textEmailAddress"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingEnd="@dimen/spacing_medium"
                android:background="@drawable/neo_input"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <!-- Password -->
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_medium"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingEnd="@dimen/spacing_medium"
                android:background="@drawable/neo_input"

                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <!-- Login Button -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="LOGIN"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="@dimen/text_normal"
                android:background="@drawable/neo_button"
                android:elevation="@dimen/neo_elevation" />

        </LinearLayout>

        <!-- Forgot Password -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="Forgot password?"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_normal" />

        <!-- Register -->
        <TextView
            android:id="@+id/tvRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="Don't have an account? Create account"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_normal" />

    </LinearLayout>

</ScrollView>

