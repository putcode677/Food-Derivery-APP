<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark inner shadow -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="0dp"
        android:bottom="0dp">

        <shape android:shape="rectangle">
            <solid android:color="#C5CCD3"/>
            <corners android:radius="@dimen/radius_medium"/>
        </shape>

    </item>

    <!-- Input surface -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="4dp"
        android:bottom="4dp">

        <shape android:shape="rectangle">
            <solid android:color="@color/neo_background"/>
            <corners android:radius="@dimen/radius_medium"/>
        </shape>

    </item>

</layer-list>