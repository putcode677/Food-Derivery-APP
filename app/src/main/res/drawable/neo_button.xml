<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark shadow -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="0dp"
        android:bottom="0dp">

        <shape android:shape="rectangle">
            <solid android:color="#C0C7CE"/>
            <corners android:radius="@dimen/radius_medium"/>
        </shape>

    </item>

    <!-- Button surface -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="5dp"
        android:bottom="5dp">

        <shape android:shape="rectangle">
            <solid android:color="@color/primary"/>
            <corners android:radius="@dimen/radius_medium"/>
        </shape>

    </item>

</layer-list>