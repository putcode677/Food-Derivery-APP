<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark shadow -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="0dp"
        android:bottom="0dp">

        <shape android:shape="rectangle">
            <solid android:color="#C5CCD3"/>
            <corners android:radius="@dimen/radius_large"/>
        </shape>

    </item>

    <!-- Main surface -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="6dp"
        android:bottom="6dp">

        <shape android:shape="rectangle">
            <solid android:color="@color/neo_background"/>
            <corners android:radius="@dimen/radius_large"/>
        </shape>

    </item>

</layer-list>