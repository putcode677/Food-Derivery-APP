<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="0dp"
        android:bottom="0dp">

        <shape android:shape="rectangle">
            <solid android:color="#091B2B" />

            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Main surface -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="3dp"
        android:bottom="3dp">

        <shape android:shape="rectangle">

            <solid android:color="#E8EEF5" />

            <corners android:radius="16dp" />

            <stroke
                android:width="1dp"
                android:color="#234D6B" />

            <padding
                android:left="14dp"
                android:top="0dp"
                android:right="14dp"
                android:bottom="0dp" />

        </shape>
    </item>

</layer-list>

