<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="0dp"
        android:bottom="0dp">

        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#091B2B" />
        </shape>

    </item>

    <!-- Main surface -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="6dp"
        android:bottom="6dp">

        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#0F2A43" />
        </shape>

    </item>

</layer-list>

